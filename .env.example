# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Cricket API Key (Optional - uses Simulation Mode if missing)
# Example: RapidAPI Cricbuzz API Key
CRICKET_API_KEY=your_cricket_api_key_here

# Giphy API Key (Optional - uses fallback dictionary if missing)
GIPHY_API_KEY=your_giphy_api_key_here
