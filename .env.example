# VibeStump — Environment Variables
# Copy this file to .env before deploying.

# Google Gemini API Key (REQUIRED)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 (optional — enables Match VOD highlights)
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# RapidAPI Cricbuzz (optional — enables live match data)
# Subscribe at: https://rapidapi.com/cricbuzz-cricket
RAPIDAPI_KEY=
