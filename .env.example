# VibeStump — Environment Variables
# Copy this file to .env and fill in your API keys.
# All keys are optional — the system uses DuckDuckGo as the primary
# real-time data source and falls back gracefully when APIs are unavailable.

# Google Gemini 2.5 Flash — AI insights, chatbot, structured data parsing
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 — highlight video search
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Tenor API v2 — cricket reaction GIFs on boundaries and wickets
# Get yours at: https://tenor.com/gifapi
TENOR_API_KEY=

