# VibeStump — Environment Variables
# Copy this file to .env and fill in your keys.

# Google Gemini API Key (Required for Psychologist & Historian agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Cricket API Key (Optional — app uses public RSS + simulation fallback)
CRICKET_API_KEY=

# YouTube Data API v3 Key (Optional — enables Match VOD highlights)
YOUTUBE_API_KEY=
