@startuml VibeStump_Architecture

skinparam defaultFontName Arial
skinparam roundcorner 12
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #333333
skinparam packageBackgroundColor #F8F9FA
skinparam nodeBackgroundColor #E8F0FE
skinparam componentBackgroundColor #FFFFFF
skinparam arrowColor #4285F4

title VibeStump - Agentic Premier League Architecture

actor "Fan\n(Browser)" as Fan

rectangle "Google Cloud Run" {

  node "Frontend Service\n(Next.js + Tailwind)" as FE {
    [Zustand Store] as Store
    [Framer Motion] as Animations
    [React-Player] as Background
    [API Proxy] as Proxy
  }

  node "Backend Service\n(FastAPI + Uvicorn)" as BE {
    
    package "Agent Layer" {
      [Scout Agent] as Scout
      [Psychologist Agent] as Psych
      [Historian Agent] as Hist
      [Oracle Agent] as Oracle
    }

    package "Database Layer" {
      database "SQLite\nvibestump.db" as DB
    }
    
    [Dynamic Match Simulator] as Sim
  }
}

cloud "External APIs" {
  [ESPNcricinfo\nRSS Feed] as RSS
  [Google Gemini\n2.5 Flash] as Gemini
  [Google Search API\n(Gemini Tool)] as GSearch
  [Tenor API] as Tenor
  [YouTube\nData API v3] as YT
}

' -- Data Flow --
Fan --> FE : HTTPS\n(polling every 8-30s)
FE --> Proxy : Next.js API Routes
Proxy --> BE : REST API

BE --> Scout
Scout --> RSS : httpx async
Scout ..> Sim : fallback (no live match)
Sim --> Gemini : generates match events
Scout --> DB : stores match data

BE --> Psych
Psych --> Gemini : structured JSON schema
Psych --> Tenor : fetch dynamic meme

BE --> Hist
Hist --> Gemini : historical context

BE --> Oracle
Oracle --> Gemini : Oracle Predictions
Oracle --> GSearch : Live stats & chat

BE --> YT : search highlights

Store --> Animations : triggers UI updates
Store --> Background : dynamic theme

@enduml
