@startuml VibeStump_Architecture

skinparam defaultFontName Arial
skinparam roundcorner 12
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #333333
skinparam packageBackgroundColor #F8F9FA
skinparam nodeBackgroundColor #E8F0FE
skinparam componentBackgroundColor #FFFFFF
skinparam arrowColor #4285F4

title VibeStump - Agentic Premier League Architecture

actor "Fan\n(Browser)" as Fan

rectangle "Google Cloud Run" {

  node "Frontend Service\n(Next.js + Tailwind)" as FE {
    [Zustand Store] as Store
    [Recharts] as Charts
    [TeamSelector] as Theme
  }

  node "Backend Service\n(FastAPI + Uvicorn)" as BE {

    package "Agent Layer" {
      [Scout Agent] as Scout
      [Psychologist Agent] as Psych
      [Historian Agent] as Hist
      [Executor Agent] as Exec
    }

    package "Fallback Layer" {
      [SimulatedLiveFeed\nlive_sim.json] as Sim
      [Meme Dictionary] as Memes
      [YouTube Fallbacks] as YTFall
    }
  }
}

cloud "External APIs" {
  [Cricbuzz\nRapidAPI] as Cricbuzz
  [ESPNcricinfo\nRSS Feed] as RSS
  [Google Gemini\n2.5 Flash] as Gemini
  [YouTube\nData API v3] as YT
  [Swiggy / Netflix\n(Mock)] as Mock
}

' -- Data Flow --
Fan --> FE : HTTPS\n(polling every 8-30s)
FE --> BE : REST API\n(/api/score, /api/analyze, ...)

BE --> Scout
Scout --> Cricbuzz : httpx async
Scout --> RSS : httpx fallback
Scout ..> Sim : local fallback\n(429/500 errors)

BE --> Psych
Psych --> Gemini : structured JSON\nschema output

BE --> Hist
Hist --> Gemini : historical\nprompt + context

BE --> Exec
Exec --> Memes : mood to GIF URL
Exec --> Mock : Diversion Protocol

BE --> YT : search highlights
YT ..> YTFall : fallback videos

Store --> Charts : vibe history\ntension data
Theme --> Store : team colors\nCSS variables

@enduml
