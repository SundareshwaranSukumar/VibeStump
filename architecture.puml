@startuml VibeStump_Architecture
skinparam defaultFontName Arial
skinparam roundcorner 12
skinparam backgroundColor #1A1A2E
skinparam defaultFontColor #E0E0E0
skinparam packageBackgroundColor #16213E
skinparam nodeBackgroundColor #0F3460
skinparam componentBackgroundColor #1A1A2E
skinparam componentBorderColor #4FC3F7
skinparam arrowColor #4FC3F7
skinparam rectangleBorderColor #4FC3F7
skinparam packageBorderColor #4FC3F7
skinparam actorBorderColor #4FC3F7
skinparam databaseBorderColor #4FC3F7
skinparam cloudBorderColor #EF4444
skinparam noteBorderColor #FFB74D
skinparam noteBackgroundColor #2D1B00
skinparam titleFontColor #FFFFFF
skinparam titleFontSize 18

title
VibeStump — Agentic Premier League
Real-Time IPL Dashboard v2.0.0
end title

actor "IPL Fan" as Fan

rectangle "Frontend - Next.js 15 - Port 3000" as FE {
  package "Root Layout" {
    [ClientProviders] as CP
    note right of CP
      Mounts StumpMindChat globally.
      Chatbot floats on home,
      team, and player pages.
    end note
  }
  package "Navigation" {
    [Header] as HDR
    [MatchSelector] as MS
    note right of MS
      Two dropdowns:
      Today    - status = LIVE
      Previous - status = COMPLETED
    end note
  }
  package "Dashboard Header" {
    [Scoreboard] as SCB
    [TeamsGrid] as TG
    note right of TG
      Outer glass card wraps inner
      frosted card. Shows all 10
      IPL team badges + full names.
    end note
  }
  package "Left Column" {
    [LiveVideoPlayer] as LVP
    [RunsGraph] as RG
    note right of RG
      Dual-innings line chart.
      batting_team field groups data.
      Recharts Legend with team colors.
      Heading: Runs Progression - Both Innings.
    end note
    [Commentary Feed] as CF
    [Highlights] as HL
    note right of HL
      Card-based UI, no iframe embed.
      Team-colored gradient cards.
      External YouTube link button.
      onError hides broken images.
    end note
  }
  package "Right Column" {
    [AgentCommentary] as AC
    [Jumbotron] as JMB
    note right of JMB
      LED dot-matrix stadium display.
      SIX / FOUR / WICKET / NOBALL / DOT overlays.
      EmojiRain child component.
      Strategic Timeout mode with countdown.
      5s auto-reset after events.
      Live Score from Zustand store.
    end note
    [PointsTable] as PT
    [UpcomingMatches] as UM
  }
  package "Page Routes" {
    [Team Detail Page] as TDP
    note right of TDP
      Playing XI with role badges:
      BAT, WK, ALL, BOWL.
      Captain C and WK markers.
      Bench substitutes section.
      Recent results + upcoming from DB.
    end note
    [Player Profile Page] as PPP
    [API Proxy Route] as APR
    note right of APR
      /api/[...path] handler forwards
      all requests to FastAPI backend.
    end note
  }
  package "Global Chatbot" {
    [StumpMindChat] as SMC
  }
  package "Dual-Agent Data Orchestration" {
    [AgentDataRouter] as ADR
    note right of ADR
      Classifies every data request:
      STATIC  - TTL greater than 1 hour
        Player profiles, team rosters,
        career stats, coach, home ground.
        Route to The Librarian Agent.
      DYNAMIC - TTL less than 1 minute
        Live score, commentary, events,
        run rate, tension index, memes.
        Route to The Live Reporter Agent.
      Classification by keyword matching
      with explicit type override support.
    end note
    [CacheManager] as CM
    note right of CM
      localStorage-based static cache.
      TTL: 60 minutes per entry.
      Zero-latency repeat loads.
      Never caches DYNAMIC data.
      Graceful: quota errors skipped.
    end note
    [useLibrarianAgent Hook] as ULA
    note right of ULA
      The Librarian Agent.
      1. Check CacheManager first.
      2. Cache hit  - return instantly.
      3. Cache miss - show Compiling Dossier.
      4. Fetch from /api/teams or /api/players.
      5. Store in CacheManager.
      Used by: Team Page, Player Page.
    end note
    [useLiveReporterAgent Hook] as ULRA
    note right of ULRA
      The Live Reporter Agent.
      Polls /api/live-score and
      /api/commentary every 5 seconds.
      No caching. Pure speed.
      Stops polling on component unmount.
      Used by: Live Match dashboard.
    end note
    [useAgentData Hook] as UAD
    note right of UAD
      Universal hook. Components call this
      instead of fetching directly.
      Internally delegates to Librarian
      or Live Reporter based on routing.
    end note
  }
  package "Shared State" {
    [Zustand Store] as ZS
    note right of ZS
      selectedMatchId, score,
      commentary, scoreProgression,
      highlights, insights,
      activeEvent, activeEventGlow,
      matches, theme (light default)
    end note
    [api.ts HTTP helpers] as APITS
    [SoundManager] as SND
    note right of SND
      WICKET, SIX, FOUR audio cues.
      Initialized on first user click.
    end note
    [Next.js API Proxy] as NP
  }
}

rectangle "Backend - FastAPI - Port 8000" as BE {
  package "seed.py Schema Init" {
    [run_seed at lifespan startup] as SEED
    note right of SEED
      Initialises all DB tables via init_db().
      Seeds verified IPL 2026 data:
        - 10-team points table (RCB #1, 16pts)
        - Match results 55-57
        - Upcoming fixtures 59-63
      Clears stale fabricated data first.
      Agents override with live Cricbuzz
      data immediately after startup.
    end note
  }
  package "6 AI Agents 10s cycle" {
    [ScoreAgent] as A1
    note right of A1
      1. ESPN Cricinfo RSS feed (PRIMARY).
         Filters for IPL matches only.
         Parses: "Punjab Kings 200/8 v Mumbai Indians 53 *"
         Handles both /N and bare N formats.
         Overs default to empty (RSS has none).
      2. Fallback: preserve existing DB
         data until fresh data arrives.
    end note
    [CommentaryAgent] as A2
    note right of A2
      Detects score delta each agent cycle.
      Events: WICKET, SIX, FOUR, RUNS.
      Writes event_type to commentary table.
    end note
    [InsightsAgent] as A3
    note right of A3
      1. Gemini 2.5 Flash with match context.
      2. Fallback: stores contextual message.
      fetch_latest_news() called on startup.
    end note
    [MediaAgent] as A4
    note right of A4
      1. YouTube Data API v3 search.
      2. Fallback: extracts video IDs via regex.
      Frontend: card UI, external links.
    end note
    [MemeAgent] as A5
    note right of A5
      1. Tenor API v2 for reaction GIF.
      2. Fallback: emoji reaction in UI.
      Only fires on WICKET, SIX, FOUR.
    end note
    [DataFetchAgent] as A6
    note right of A6
      Runs IMMEDIATELY on startup.
      PRIMARY: Cricbuzz series page scrape.
        Series ID 9241 (IPL 2026).
        Fetches Next.js RSC JSON payload.
        Extracts: points table, fixtures,
        results, team standings.
      FALLBACK: hardcoded verified seed data
        Matches 55-63 (real IPL 2026 fixtures).
        Ensures dashboard always shows
        real, meaningful data.
      Periodic refresh every 30 cycles (~5min).
    end note
  }
  package "REST API Endpoints" {
    [GET matches] as EP1
    [GET live-score] as EP2
    [GET score-progression] as EP3
    [GET commentary] as EP4
    [GET highlights] as EP5
    [GET insights] as EP6
    [GET meme] as EP7
    [GET teams list] as EP8
    [GET team by code] as EP9
    [GET player by name] as EP10
    [GET points-table] as EP11
    [GET upcoming-matches] as EP12
    [POST chat StumpMind] as EP13
    [GET completed-matches] as EP14
    [GET match-result by id] as EP15
    [GET search] as EP16
    [GET live-search] as EP17
  }
  package "SQLite DB WAL mode" {
    database "vibestump.db" as DB {
      [matches table] as T1
      [live_scores table] as T2
      [score_progression with batting_team] as T3
      note right of T3
        batting_team column ensures both
        innings are stored under same
        match_id and graphed separately.
      end note
      [commentary with event_type] as T4
      [highlights table] as T5
      [insights table] as T6
      [memes table] as T7
      [points_table] as T8
      [upcoming_matches table] as T9
      [match_results table] as T10
    }
  }
  package "tools.py" {
    [IPL_TEAMS metadata] as TR1
    [SQUAD_DATA Playing XI and bench] as TR2
    note right of TR2
      All 10 IPL 2026 teams. Per player:
      name, role (BAT, WK, ALL, BOWL),
      captain flag, wicketkeeper flag.
      Real IPL 2026 rosters (Rajat Patidar
      as RCB captain, etc.)
    end note
    [Cricbuzz scraper] as TR3
    note right of TR3
      fetch_cricbuzz_ipl_live()
        Fetches series page RSC JSON.
        Series ID 9241 (IPL 2026).
      fetch_cricbuzz_points_table()
        Extracts standings from RSC JSON.
      _extract_rsc_text()
        Finds self.__next_f data chunks.
      _find_balanced_json()
        Extracts valid JSON from RSC stream.
    end note
    [RSS + YouTube + Tenor] as TR4
    note right of TR4
      fetch_cricinfo_rss()    ESPN Cricinfo RSS
      parse_match_title()     flexible score parser
        handles "53 *" (no wickets fallen)
        and "200/8" (wickets scored) formats
        overs default to empty string
      fetch_youtube_highlights() YT API
      fetch_tenor_meme()      Tenor API
    end note
  }
}

cloud "External Data Sources" as EXT {
  [ESPN Cricinfo RSS - PRIMARY live scores] as RSS
  [Cricbuzz.com series 9241 - PRIMARY data] as CB
  [Google Gemini 2.5 Flash] as GEM
  [YouTube Data API v3] as YT
  [Tenor API v2] as TNR
}

note bottom of EXT
  ESPN Cricinfo RSS is the PRIMARY live score source.
  Title format: "Punjab Kings 200/8 v Mumbai Indians 53 *"
  Updated every ball during live matches.
  
  Cricbuzz series/9241 is the PRIMARY source for:
  points table, match results, upcoming fixtures.
  Scraped via RSC JSON (no API key required).
  
  Gemini 2.5 Flash generates AI insights and
  powers the StumpMind chatbot.
end note

cloud "GCP Cloud Run" as GCP {
  [vibestump-api - Backend Service] as GCPBE
  note right of GCPBE
    Region: asia-south1 (Mumbai)
    Port: 8000
    Image: Artifact Registry
    Min instances: 1
    Env: GEMINI_API_KEY, YOUTUBE_API_KEY,
         TENOR_API_KEY via --set-env-vars
  end note
  [vibestump-ui - Frontend Service] as GCPFE
  note right of GCPFE
    Region: asia-south1 (Mumbai)
    Port: 3000
    Image: Artifact Registry
    Env: API_URL=vibestump-api Cloud Run URL
    Output: standalone (node server.js)
  end note
}

package "deploy.sh" {
  [deploy.sh local] as DSH1
  note right of DSH1
    Full local setup:
    pip install -r requirements.txt
    npm install
    Initialises DB schema via seed.py.
    Agents populate live data on startup.
  end note
  [deploy.sh start] as DSH2
  note right of DSH2
    uvicorn main:app --host 0.0.0.0 --port 8000
    node .next/standalone/server.js
    NOT next start (standalone output mode).
  end note
  [deploy.sh setup / backend / frontend] as DSH3
  note right of DSH3
    setup:    gcloud APIs + Artifact Registry
    backend:  docker build + push + gcloud run deploy
    frontend: docker build + push + gcloud run deploy
    status:   show live Cloud Run service URLs
  end note
}

Fan --> HDR
Fan --> MS  : select match
Fan --> JMB : view Jumbotron
Fan --> TDP : view team squad
Fan --> SMC : ask cricket question

MS   --> ZS  : setSelectedMatchId
ZS   --> APITS
APITS --> NP

NP --> EP2  : poll 5s
NP --> EP3  : poll 5s
NP --> EP4  : poll 5s
NP --> EP1  : poll 30s
NP --> EP5  : poll 120s

EP4 --> ZS  : set activeEvent
ZS  --> JMB : activeEvent triggers Jumbotron
ZS  --> SCB : activeEventGlow animates
ZS  --> SND : play audio cue

' Dual-Agent Routing
TDP --> UAD : useAgentData team
PPP --> UAD : useAgentData player
UAD --> ADR : classify request
ADR --> ULA : STATIC route
ADR --> ULRA : DYNAMIC route
ULA --> CM  : cache check / write
ULA --> NP  : cache miss - fetch
ULRA --> NP : direct poll 5s (no cache)

' Agent data flows
A1  --> RSS  : fetch live scores (PRIMARY)
A2  --> DB   : write commentary on real delta
A3  --> GEM  : AI insight generation
A4  --> YT   : try YouTube API
A5  --> TNR  : fetch Tenor GIF
A6  --> CB   : scrape Cricbuzz RSC JSON (PRIMARY)
A6  --> SEED : hardcoded fallback if scrape fails

' Chatbot
EP13 --> GEM : generate response with DB context
EP16 --> DB  : search local data
EP17 --> RSS : live scores

' DB writes
A1  --> DB
A3  --> DB   : store insights
A4  --> DB   : store highlight video IDs
A6  --> DB   : upsert points_table, upcoming_matches, match_results

' DB reads
DB --> EP1
DB --> EP2
DB --> EP3
DB --> EP4
DB --> EP5
DB --> EP6
DB --> EP7
DB --> EP8
DB --> EP11
DB --> EP12
DB --> EP14
DB --> EP15
TR2 --> EP9

NP --> EP14 : fetch completed matches
NP --> EP15 : fetch match result

SEED --> DB

' GCP deployment flows
DSH3 --> GCPBE : gcloud run deploy backend
DSH3 --> GCPFE : gcloud run deploy frontend
Fan  --> GCPFE : HTTPS (Cloud Run URL)
GCPFE --> GCPBE : API_URL proxy

@enduml
